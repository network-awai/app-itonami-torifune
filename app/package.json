{
  "name": "@itonami/torifune-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "itonami": {
    "id": "network.itonami.torifune",
    "title": "Torifune",
    "storageKey": "itonami.torifune.v1",
    "description": "鳥船 — 民生用ロケットの機体グラフを、この端末で検算します。段ごとの Δv（ツィオルコフスキー）、推進剤の正味の炭素収支、段とデブリの処分計画を、repo の種データ（代表的な推定値）から計算します。兵器の運搬は表現できず、外部へは何も送信しません。",
    "cljsSources": [
      "../src"
    ],
    "storeId": "network.itonami.torifune"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "tauri": "tauri",
    "build:desktop": "npm run build && tauri build --no-bundle",
    "build:android": "sh scripts/android-apk.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "3.0.0-alpha.6"
  }
}
